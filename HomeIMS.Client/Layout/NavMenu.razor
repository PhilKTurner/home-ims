@using HomeIMS.SharedContracts.Domain.Inventories

@inject HttpClient HttpClient

<MudNavMenu>
    <MudNavLink Href="/" Match="NavLinkMatch.All">Dashboard</MudNavLink>
    @foreach (var inventory in inventories)
    {
        <MudNavLink Href="@($"/inventory/{inventory.Id}")" Match="NavLinkMatch.Prefix">@inventory.Name</MudNavLink>
    }
    <MudNavGroup Title="Administration" Expanded="true">
        <MudNavLink Href="/inventories" Match="NavLinkMatch.Prefix">Inventories</MudNavLink>
        <MudNavLink Href="/article-groups" Match="NavLinkMatch.Prefix">Article Groups</MudNavLink>
        <MudNavLink Href="/articles" Match="NavLinkMatch.Prefix">Articles</MudNavLink>
        <MudNavLink Href="/users" Match="NavLinkMatch.Prefix">Users</MudNavLink>
    </MudNavGroup>
</MudNavMenu>

@code {
    private IEnumerable<Inventory> inventories = new List<Inventory>();

    protected override async Task OnInitializedAsync()
    {
        inventories = await HttpClient.GetFromJsonAsync<List<Inventory>>("/inventories") ?? new List<Inventory>();
    }
}